import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

       
        int asize = sc.nextInt();
        if (asize <= 0) {
            System.out.println("Array size must be positive.");
            sc.close();
            return;
        }

        int[] a = new int[asize];
        for (int i = 0; i < asize; i++) {
            a[i] = sc.nextInt();
        }

       
        for (int i = 0; i < asize; i++) {
            if (a[i] != 0) {
                System.out.print(a[i] + " ");
            }
        }
        for (int i = 0; i < asize; i++) {
            if (a[i] == 0) {
                System.out.print(a[i] + " ");
            }
        }

        sc.close();
    }
}
