import java.util.*;

class Main {
    static int a[][] = new int[10][10], r, c;

    static void dfs(int i, int j) {
        if(i<0 || j<0 || i>=r || j>=c || a[i][j]==0) return;

        a[i][j]=0;

        for(int x=-1; x<=1; x++)
            for(int y=-1; y<=1; y++)
                if(x!=0 || y!=0)
                    dfs(i+x, j+y);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        r = sc.nextInt();
        c = sc.nextInt();

        for(int i=0;i<r;i++)
            for(int j=0;j<c;j++)
                a[i][j]=sc.nextInt();

        int count=0;

        for(int i=0;i<r;i++)
            for(int j=0;j<c;j++)
                if(a[i][j]==1){
                    dfs(i,j);
                    count++;
                }

        System.out.println(count);
    }
}
