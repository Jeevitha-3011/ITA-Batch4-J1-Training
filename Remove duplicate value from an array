import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        int dupvalue = removeDuplicates(arr, n);
        for (int i = 0; i < dupvalue; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();

        sc.close();
    }
    public static int removeDuplicates(int[] arr, int length) {
        int dupvalue = length;

        for (int i = 0; i < dupvalue; i++) {
            for (int j = i + 1; j < dupvalue; j++) {
                if (arr[i] == arr[j]) {
                  
                    for (int k = j; k < dupvalue - 1; k++) {
                        arr[k] = arr[k + 1];
                    }
                    dupvalue--;
                    j--; 
                }
            }
        }
        return dupvalue;
    }
}
